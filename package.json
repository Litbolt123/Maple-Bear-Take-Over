{
  "name": "M.B.A",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "M.B.A (Maple Bear Apocalypse) - Minecraft Bedrock Edition Addon",
  "scripts": {
    "lint": "eslint BP/scripts/ \"BP - Dev/scripts/\" tools/",
    "lint:fix": "eslint --fix BP/scripts/ \"BP - Dev/scripts/\" tools/",
    "validate:json": "node -e \"const fs=require('fs');const path=require('path');let ok=0,fail=0;const walk=(d)=>{for(const e of fs.readdirSync(d,{withFileTypes:true})){const p=path.join(d,e.name);if(e.isDirectory())walk(p);else if(e.name.endsWith('.json')){try{JSON.parse(fs.readFileSync(p,'utf8'));ok++}catch(err){console.error(p+': '+err.message);fail++}}}};walk('BP');walk('BP - Dev');walk('RP');walk('RP - Dev');console.log(ok+' JSON files valid, '+fail+' failed');if(fail)process.exit(1)\"",
    "validate:syntax": "node tools/testAllScripts.js",
    "test:scripts": "node tools/testAllScripts.js",
    "test:scripts:release": "node tools/testAllScripts.js --release-only",
    "validate": "npm run validate:json && npm run validate:syntax",
    "check": "npm run verify:build-config && npm run validate && npm run lint",
    "sync:pack-metadata": "node tools/syncPackMetadata.js",
    "bridge:config:dev": "node tools/copyBridgeConfig.js dev",
    "bridge:config:release": "node tools/copyBridgeConfig.js release",
    "bridge:config:dev:sync": "node tools/copyBridgeConfig.js dev --sync-names",
    "bridge:config:release:sync": "node tools/copyBridgeConfig.js release --sync-names",
    "version": "node tools/getVersion.js",
    "verify:build-config": "node tools/verifyBuildConfig.js",
    "release:package": "node tools/packageRelease.js",
    "sync:biome-registry": "node tools/syncBiomeReplaceRegistry.cjs",
    "sync:bp-from-dev": "node tools/syncBpFromDev.js",
    "sync:dev-to-minecraft": "node tools/syncDevPackToMinecraft.js",
    "generate:no-village-biomes": "node tools/generateNoVillageBiomeOverrides.js",
    "strip:mcstructures": "node tools/stripMcstructureArtifacts.js",
    "strip:mcstructures:dry": "node tools/stripMcstructureArtifacts.js --dry-run",
    "shift:mcstructures": "node tools/shiftMcstructureDown.js",
    "shift:mcstructures:dry": "node tools/shiftMcstructureDown.js --dry-run",
    "sync:av-plains-spawn-density": "node tools/syncAvPlainsSpawnDensity.js",
    "sync:av-plains-export-pool": "node tools/syncAvPlainsExportPool.js",
    "validate:mcstructures": "node tools/validateMcstructures.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Litbolt123/Maple-Bear-Apocalypse.git"
  },
  "keywords": [
    "minecraft",
    "bedrock",
    "addon"
  ],
  "author": "Litbolt123 and Compoohter",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Litbolt123/Maple-Bear-Apocalypse/issues"
  },
  "homepage": "https://github.com/Litbolt123/Maple-Bear-Apocalypse#readme",
  "devDependencies": {
    "eslint": "^10.0.3",
    "prismarine-nbt": "^2.8.0"
  }
}
